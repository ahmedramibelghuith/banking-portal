{
  "name": "banking-portal",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "backend": "cd GestionBanque && ./mvnw spring-boot:run",
    "e2e": "playwright test",
    "package": "npm run build && cd GestionBanque && ./mvnw -B -ntp -Pfrontend package",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"e2e/**/*.ts\" playwright.config.ts eslint.config.mjs proxy.conf.json angular.json package.json README.md \"docs/**/*.md\" \".github/workflows/*.yml\" .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"e2e/**/*.ts\" playwright.config.ts eslint.config.mjs proxy.conf.json angular.json package.json README.md \"docs/**/*.md\" \".github/workflows/*.yml\" .prettierrc.json",
    "lint": "eslint src e2e playwright.config.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": "^26.0.0"
  }
}
